;; Spirit in Physics — https://sip.itonami.app
;; A cozy slow-life healing game. clj is the brain; Datomic/datalevin is the
;; world; Kotoba is the content-addressed durable + distributed layer; the GPU
;; work stays on kami-render (Rust/wgpu) via kami-engine-sdk's render-IR.
;;
;; Stack rationale lives in docs/ARCHITECTURE.md. Source IP (story-bible) is the
;; single source of truth at ../../com-junkawasaki/org-spirit-in-physics-comics.
{:paths ["src" "resources"]

 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.text"}
       org.clojure/clojure       {:mvn/version "1.12.0"}

        io.github.kotoba-lang/json

          {:git/url "https://github.com/kotoba-lang/kotoba.git"

           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"

           :deps/root "lib/kotoba.json"}      ; read story-bible JSON-LD
        ;; The engine SDK: scene/ecs/sim/db/render-IR contract over kami-render.
        ;; (was kami-engine-sdk-clj; renamed — ADR-2607102200 addendum 1)
        gftd/kami-engine-sdk
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.kamiEngineSdk"}
        ;; Work-agnostic 2D manga render commons (ADR-2606282100): STYLE-FIRST
        ;; CLIP-77 compose + image-gen client. sip.render injects work mappers.
        gftd/kami-mangaka-render
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.kamiMangakaRender"}
        ;; Work-agnostic graphic-novel page composition (komawari + Java2D DTP).
        ;; sip.page wires sip.storyboard into page/compose-page!.
        gftd/kami-mangaka-page
          {:git/url "https://github.com/kotoba-lang/kotoba.git"
           :git/sha "73e3c67a02221411c7685c43998df5d5d85e66f3"
           :deps/root "lib/kotoba.kamiMangakaPage"}}

 :aliases
 {;; ----- JVM authoring: build the water-city world → datalevin → snapshot ----
  :datomic   {:extra-deps {datalevin/datalevin {:mvn/version "0.9.22"}}}

  :dev       {:extra-paths ["dev" "examples"]
              :extra-deps  {datalevin/datalevin          {:mvn/version "0.9.22"}
                            org.clojure/tools.namespace  {:mvn/version "1.5.0"}}
              :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                            "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}

  ;; Build the portable snapshot served to the browser:
  ;;   kbb -M:datomic:build -m sip.world
  :build     {:extra-paths ["dev"]
              :main-opts   ["-m" "sip.world"]}

  ;; Compose / render / load manga panels from the story-bible anchors:
  ;;   kbb -M:datomic:render compose 02-02b
  ;;   kbb -M:datomic:render render  02-02b out.png   (needs image-gen @ :8100)
  ;;   kbb -M:datomic:render load    /tmp/sip-world
  :render    {:main-opts ["-m" "sip.render"]}

  ;; ----- Browser runtime (ClojureScript → kami-render WASM → WebGPU) ---------
  :shadow    {:extra-paths ["src"]
              :extra-deps  {thheller/shadow-cljs       {:mvn/version "2.28.20"}
                            org.clojure/clojurescript  {:mvn/version "1.11.132"}
                            org.clojure/core.async     {:mvn/version "1.6.681"}  ; kami.backend.browser
                            com.cognitect/transit-cljs {:mvn/version "0.8.280"}}
              :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

  ;; ----- Pure logic tests (no GPU, no DB): session FSM, kokoro, awakening -----
  ;; sip.store-test needs a real datalevin store -- run the full suite with
  ;; `kbb -M:datomic:test` (sip.store-test's own docstring says so too).
  ;; kbb runs the .cljk tests (the cognitect runner below cannot read .cljk):
  ;;   kbb -M:kbb-test
  :kbb-test  {:extra-paths ["test"]
              :main-opts   ["-m" "sip.all-test"]}

  :test      {:extra-paths ["test"]
              :extra-deps  {io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
              :main-opts   ["-m" "cognitect.test-runner"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed). --fail-level
  ;; error so clj-kondo actually gates CI.
  :lint      {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
              :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                          "--fail-level" "error"]}}}
